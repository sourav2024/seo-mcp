# ---------------------------------------------------------------------------
# seo-mcp configuration
#
# Every variable is OPTIONAL — the defaults shown are what the server uses when
# the variable is unset. Invalid values fall back to the default and log a
# warning rather than crashing, so a typo can never make the server unusable.
#
# This server does NOT read .env files itself (MCP servers are launched by a
# client, not a shell). Set these in your MCP client's config, e.g.:
#
#   {
#     "mcpServers": {
#       "technical-seo": {
#         "command": "npx",
#         "args": ["-y", "technical-seo-mcp"],
#         "env": { "SEO_MCP_LOG_LEVEL": "debug" }
#       }
#     }
#   }
#
# There are no API keys or secrets: every check runs against the public web.
# ---------------------------------------------------------------------------

# --- Logging ---------------------------------------------------------------

# Verbosity: silent | error | warn | info | debug
# Logs go to stderr only (stdout carries the MCP protocol). "debug" adds
# per-request timing, byte counts, and full error stacks.
SEO_MCP_LOG_LEVEL=info

# Log shape: json (one object per line, machine-readable) | text (human-readable)
SEO_MCP_LOG_FORMAT=json

# --- Network ---------------------------------------------------------------

# Per-request timeout for page fetches, in ms. Range: 1000–120000.
# Raise this for slow sites that time out mid-audit.
SEO_MCP_FETCH_TIMEOUT_MS=20000

# Shorter timeout for the HTTPS/redirect probes, which should fail fast. 1000–120000.
SEO_MCP_PROBE_TIMEOUT_MS=15000

# Hard cap on bytes read from any single response body. Range: 65536–268435456.
# Audits only inspect markup, so this exists to stop a huge asset from
# exhausting memory.
SEO_MCP_MAX_BODY_BYTES=10485760

# Maximum redirect hops followed before giving up. Range: 1–20.
SEO_MCP_MAX_REDIRECT_HOPS=5

# --- Crawling --------------------------------------------------------------

# Politeness delay between crawled pages, in ms. Range: 0–60000.
# Lower it for your own sites; keep it for sites you do not control.
SEO_MCP_CRAWL_DELAY_MS=500

# Upper bound on crawl_audit's max_pages, regardless of what the caller asks
# for. Range: 1–1000.
SEO_MCP_CRAWL_MAX_PAGES=100

# Concurrent page fetches during a crawl. Range: 1–8.
# The default of 1 is deliberately gentle on the target site.
SEO_MCP_CRAWL_CONCURRENCY=1

# --- Lighthouse ------------------------------------------------------------

# Timeout for a full Lighthouse run, in ms. Range: 30000–600000.
SEO_MCP_LIGHTHOUSE_TIMEOUT_MS=180000

# Explicit Chrome/Chromium/Edge binary. Auto-detected when unset; set this if
# Chrome is installed somewhere non-standard. Only run_lighthouse needs it.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# --- Storage ---------------------------------------------------------------

# Where compare_to_baseline stores per-target baselines. Defaults to the OS
# convention:
#   macOS   ~/Library/Application Support/seo-mcp
#   Linux   $XDG_STATE_HOME/seo-mcp or ~/.local/state/seo-mcp
#   Windows %LOCALAPPDATA%\seo-mcp
# Point it at a path inside your repo to commit baselines alongside the project:
# SEO_MCP_STATE_DIR=./.seo-baselines

# --- Safety ----------------------------------------------------------------

# Allow auditing private, loopback, and link-local addresses (localhost:3000,
# 10.x, 192.168.x, and the 169.254.169.254 cloud-metadata range).
#
# Default: true — auditing a local dev server is a primary use case.
# Set to false when the server can receive URLs you do not control; this turns
# SSRF protection on, blocking private targets and re-checking every redirect.
SEO_MCP_ALLOW_PRIVATE_HOSTS=true
